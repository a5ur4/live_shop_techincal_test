# Copie para `.env` se quiser sobrescrever os padrões (`cp .env.example .env`).
# Nenhuma variável é obrigatória: os valores abaixo já são os padrões do projeto.

# Credenciais do Postgres usadas pelo docker-compose
POSTGRES_USER=feed
POSTGRES_PASSWORD=feed
POSTGRES_DB=feed
POSTGRES_PORT=5432

# Porta exposta da API no host
API_PORT=8000

# Popula dados de exemplo ao subir a API no Docker, se o banco estiver vazio (true/false)
SEED_DB=true

# Conexão da API rodando fora do Docker (ex.: `make dev`, `make test`).
# Use 127.0.0.1, não "localhost": as portas do compose são só IPv4 e, no Windows,
# "localhost" tenta ::1 primeiro e leva ~2s para cair no IPv4 (o Redis dá timeout).
DATABASE_URL=postgresql+asyncpg://feed:feed@127.0.0.1:5432/feed
TEST_DATABASE_URL=postgresql+asyncpg://feed:feed@127.0.0.1:5432/feed_test

# Redis (cache do feed e rate limit do login). Vazio desliga ambos.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/15
# Segundos que a primeira página do feed fica em cache (0 desliga)
FEED_CACHE_TTL_S=30

# Tempo máximo de cada query no Postgres, em milissegundos
DB_STATEMENT_TIMEOUT_MS=5000

# Autenticação (JWT HS256). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio = chave aleatória a cada start da API (tokens deixam de valer ao reiniciar).
# Mínimo de 32 caracteres. NUNCA versione a chave real.
JWT_SECRET=
JWT_EXPIRA_MINUTOS=30
REFRESH_EXPIRA_DIAS=30

# Rate limit do login: falhas permitidas por janela
LOGIN_MAX_FALHAS_EMAIL=5
LOGIN_MAX_FALHAS_IP=20
LOGIN_JANELA_MINUTOS=15

# Loga todo SQL executado (útil para depurar)
SQL_ECHO=false
