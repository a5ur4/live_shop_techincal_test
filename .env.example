# Copie para `.env` se quiser sobrescrever os padrões (`cp .env.example .env`).
# Nenhuma variável é obrigatória: os valores abaixo já são os padrões do projeto.

# Credenciais do Postgres usadas pelo docker-compose
POSTGRES_USER=feed
POSTGRES_PASSWORD=feed
POSTGRES_DB=feed
POSTGRES_PORT=5432

# Porta exposta da API no host
API_PORT=8000

# Conexão da API rodando fora do Docker (ex.: `make dev`, `make test`)
DATABASE_URL=postgresql+asyncpg://feed:feed@localhost:5432/feed
TEST_DATABASE_URL=postgresql+asyncpg://feed:feed@localhost:5432/feed_test

# Tempo máximo de cada query no Postgres, em milissegundos
DB_STATEMENT_TIMEOUT_MS=5000

# Loga todo SQL executado (útil para depurar)
SQL_ECHO=false
